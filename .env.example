# ---------------------------------------------------------------------------
# Environment template — copy to `.env` and adjust as needed:
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# `.env` is git-ignored; commit only this example file.
# ---------------------------------------------------------------------------

# Database engine: "sqlite" (zero-config file) or "mysql" (XAMPP / MariaDB).
# Leave DATABASE_URL unset for local dev; switch engines here instantly.
DB_ENGINE=mysql

# --- MySQL / XAMPP (used when DB_ENGINE=mysql) -----------------------------
# Defaults below match a stock XAMPP install: root user, empty password.
MYSQL_DB=market_rental
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# --- Django basics ---------------------------------------------------------
DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=change-me-in-production
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production override ---------------------------------------------------
# When set, this takes precedence over DB_ENGINE (e.g. a hosted MySQL/Postgres).
# DATABASE_URL=mysql://user:password@host:3306/dbname
