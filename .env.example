# ---------------------------------------------------------------------------
# Environment template — copy to `.env` and adjust as needed:
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# `.env` is git-ignored; commit only this example file.
# ---------------------------------------------------------------------------

# --- Django basics ---------------------------------------------------------
DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=change-me-in-production
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.apps.run-on-seenode.com

# --- SQLite path (optional) ------------------------------------------------
# Defaults to <BASE_DIR>/db.sqlite3. Set this if mounting a persistent volume
# on Seenode (e.g. /data/db.sqlite3).
# SQLITE_DB_PATH=/data/db.sqlite3

# --- Deploy user & data seeding (Seenode) ----------------------------------
# Auto-seeds admin, collector, and sample tenants on fresh deploys when the DB
# is empty (never resets existing admin/collector passwords). Set to false to disable.
AUTO_SEED_ON_DEPLOY=true
# Optional initial password overrides (only used when creating accounts):
# SEED_ADMIN_PASSWORD=admin123
# SEED_COLLECTOR_PASSWORD=collector123
# SEED_TENANT_PASSWORD=tenant123
